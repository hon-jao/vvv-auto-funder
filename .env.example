# Copy to .env and fill in. chmod 600 .env
VVV_SIGNER_KEY=0x
FUNDER_KEY=0x
FUNDER_ADDR=0x
EXPECTED_MAIN=0x
# Optional — conversion timing & behavior
# --min-usd on the command line overrides this; this env is a convenience default.
# Higher = fewer, larger conversions (less gas overhead); lower = more frequent.
# MIN_USD=12
# Optional — swap tuning
# BASE_RPC=https://mainnet.base.org
# VVV_USDC_FEE=10000
# SLIPPAGE_BPS=200
# Optional — x402 provider (default: Venice). Point at any x402-compatible provider
# whose top-up endpoint serves the standard 402 discovery flow on Base USDC.
# TOPUP_BASE_URL=https://api.venice.ai/api/v1
# TOPUP_THRESHOLD=10
# TOPUP_AMOUNT=5
# Optional — file locations
# VVV_LOG_PATH=./vvv-auto-funder.log
